# ============================================================
# 🌿 .gitignore
# ============================================================
# This file is tailored for a TypeScript + Bun + tsup + release-it package.
# It ensures only source and essential configuration files are tracked.
# ============================================================

# ------------------------------------------------------------
# 🧱 BUILD DIRECTORIES
# ------------------------------------------------------------
# Ignore build outputs — they are generated by tsup and tsc
/build/
build
/dist/
/out/
/.tsbuildinfo

# ------------------------------------------------------------
# 🧩 DEPENDENCIES
# ------------------------------------------------------------
/node_modules/
/bun.lockb
/package-lock.json
/yarn.lock
/pnpm-lock.yaml
bun.lock
package-lock.json
# ------------------------------------------------------------
# 📦 PACKAGE MANAGEMENT
# ------------------------------------------------------------
# Ignore auto-generated archives
*.tgz

# Ignore npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# ------------------------------------------------------------
# 🧪 TESTS AND COVERAGE
# ------------------------------------------------------------
/coverage/
/.vitest/

# ------------------------------------------------------------
# ⚙️ TEMPORARY & SYSTEM FILES
# ------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
*.swp
*.swo
*.tmp
*.temp
*.log
*.bak
*.orig

# ------------------------------------------------------------
# 🧠 IDE / EDITOR FILES
# ------------------------------------------------------------
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# JetBrains / WebStorm / IntelliJ
.idea/

# Others
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------
# 🔐 ENVIRONMENT & SECRETS
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# 🚀 RELEASE / VERSIONING TOOLS
# ------------------------------------------------------------
# release-it, changelogs, and temp files
.releases/
.releaserc
.release-it.json.backup
CHANGELOG.tmp

# ------------------------------------------------------------
# 📚 DOCUMENTATION BUILD (if generated automatically)
# ------------------------------------------------------------
/docs/
/doc_build/
/typedoc/

# ------------------------------------------------------------
# 🧮 MISC
# ------------------------------------------------------------
# Ignore temp scratchpad or testing files
scratch.*
temp/
tmp/

# ------------------------------------------------------------
# ✅ TRACKED FILES YOU SHOULD KEEP
# ------------------------------------------------------------
# (Ensure these are NOT ignored)
!src/
!tsup.config.ts
!tsconfig.json
!tsconfig.test.json
!vitest.config.ts
!package.json
!package.example.json
!LICENSE
!README.md
!.gitignore
!.prettierrc
!.release-it.json
